# ── Required ──────────────────────────────────────────────────────────────────
# Anthropic API key — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ──────────────────────────────────────────────────────────────────
# CMF Chile API key — free registration at https://api.cmfchile.cl
# Without this, verify_cmf_entity will return found=false
CMF_API_KEY=

# Server port (default: 3000)
PORT=3000

# ── Image fraud model (local development only) ────────────────────────────────
# Path to the csirt-img-ml-model repo root so that `import fraud_model` works
# when running outside Docker.  Not required inside the container.
# FRAUD_MODEL_BASE=/path/to/csirt-img-ml-model

# Override the path to the FAISS index and metadata JSON.
# Defaults to fraud_model/artifacts (correct in Docker and when fraud_model is
# a sibling directory of the working directory).
# FRAUD_MODEL_ARTIFACTS=/path/to/fraud_model/artifacts
